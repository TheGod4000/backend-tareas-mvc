    "db:drop": "node -e \"require('fs').rmSync('./database.sqlite',{force:true});require('fs').rmSync('./database.sqlite-journal',{force:true});console.log('[db] dropped database.sqlite');\"",
    "db:reset": "npm run db:drop && npm run db:migrate",
    "test:e2e": "playwright test"
  },
